# AutoDock — Root Environment Configuration Example
# Copy this file to .env or configure respective apps/api/.env and apps/web/.env
# NEVER commit real credentials, production connection strings, or private keys.

# ==============================================================================
# Backend Configuration (apps/api)
# ==============================================================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB Connection String (Placeholder only — do not commit real credentials)
MONGODB_URI=mongodb://localhost:27017/autodock_dev

# Client Origin (CORS allowlist)
CLIENT_ORIGIN=http://localhost:5173

# Authentication / JWT Configuration (Min 32 characters for HMAC-SHA256)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_placeholder_key_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_placeholder_key_here
JWT_REFRESH_EXPIRY=7d

# File Storage Configuration (Private AWS S3 / MinIO)
STORAGE_PROVIDER=local
STORAGE_BUCKET_PRIVATE=autodock-private-documents-dev
STORAGE_BUCKET_PUBLIC=autodock-public-assets-dev
STORAGE_REGION=ap-south-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Email Dispatch Configuration (SMTP / Mock Provider)
EMAIL_PROVIDER=mock
EMAIL_FROM="AutoDock Support <no-reply@autodock.lk>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# ==============================================================================
# Frontend Configuration (apps/web)
# ==============================================================================
# Vite public environment variables (Must start with VITE_)
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME="AutoDock Sri Lanka"
