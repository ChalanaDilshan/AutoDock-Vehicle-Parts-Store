# AutoDock Backend (.env.example)
# Copy to apps/api/.env for local development

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB Local/Atlas Connection String (Placeholder only)
MONGODB_URI=mongodb://localhost:27017/autodock_dev

# Allowed Frontend Origins for CORS
CLIENT_ORIGIN=http://localhost:5173

# JWT Secrets (Placeholder only)
JWT_ACCESS_SECRET=autodock_dev_access_secret_min_32_characters_long_12345
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=autodock_dev_refresh_secret_min_32_characters_long_67890
JWT_REFRESH_EXPIRY=7d
